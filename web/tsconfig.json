{
  // Browser scripts: each src/*.ts compiles to internal/target/html/assets/<name>.js,
  // a classic script (no imports or exports), embedded in the Go binary.
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noEmitOnError": true,
    "rootDir": "src",
    "outDir": "../internal/target/html/assets",
    "newLine": "lf",
    "removeComments": false,
    "moduleDetection": "legacy",
    "types": []
  },
  "include": ["src/*.ts"]
}
